#!/usr/bin/env python3
"""Launch `aside mcp` after resolving the CLI. One executable token for Hermes MCP."""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from aside_cli import find_aside  # noqa: E402


def main() -> int:
    binary = find_aside()
    if not binary:
        sys.stderr.write(
            "aside CLI not found. Install it from Aside Settings > Developers, "
            "or set ASIDE_BIN to the executable.\n"
        )
        return 127
    os.execv(binary, [binary, "mcp", *sys.argv[1:]])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
